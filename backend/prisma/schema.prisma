// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum ItemStatus {
  AVAILABLE
  CLAIM_PENDING
  RETURNED
  ARCHIVED
}

enum ClaimStatus {
  PENDING_VERIFICATION
  INQUIRY_REQUIRED
  APPROVED
  DENIED
  CANCELLED
  EXPIRED
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ACTIVE_SEARCH
  MATCHED
  RESOLVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CLAIM_SUBMITTED
  CLAIM_REVIEWED
  CLAIM_APPROVED
  CLAIM_DENIED
  REPORT_SUBMITTED
  REPORT_UPDATED
  REPORT_LINKED
  HANDOVER_COMPLETED
  AUTH_LOGIN
  SNAPSHOT_DISMISSED
  SNAPSHOT_RESTORED
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DISABLED
  USER_ENABLED
  USER_PASSWORD_RESET
  SYSTEM_SETTINGS_UPDATED
}

enum CameraStreamStatus {
  CONNECTING
  ONLINE
  OFFLINE
  SOURCE_IN_USE
  ERROR
}

enum NotificationType {
  SYSTEM
  CLAIM_MESSAGE
  REPORT_MESSAGE
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  studentId      String?     @unique
  name           String
  email          String      @unique
  phone          String?
  department     String?
  notificationPreferences Json?
  passwordHash   String
  role           UserRole
  status         UserStatus  @default(ACTIVE)
  passwordResetRequired Boolean @default(false)
  lastLoginAt    DateTime?   @db.Timestamptz(6)
  disabledAt     DateTime?   @db.Timestamptz(6)
  disabledReason String?
  disabledById   String?     @db.Uuid
  claims         Claim[]
  reports        LostReport[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  createdItems   FoundItem[] @relation("ItemCreatedBy")
  verifiedClaims Claim[]     @relation("ClaimVerifiedBy")
  handovers      HandoverLog[]
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
}

model FoundItem {
  id                   String          @id @default(uuid()) @db.Uuid
  code                 String          @unique
  title                String
  category             String
  color                String
  foundLocation        String
  foundAtUtc           DateTime        @db.Timestamptz(6)
  publicDescription    String?
  privateDiscoveryNote String?
  privateData          Json?
  isHighValue          Boolean         @default(false)
  status               ItemStatus      @default(AVAILABLE)
  storageLocation      String?
  claims               Claim[]
  aiEvidenceLogs       AIEvidenceLog[]
  matchedReports       LostReport[]    @relation("ReportMatchedItem")
  handoverLogs         HandoverLog[]
  createdById          String          @db.Uuid
  createdBy            User            @relation("ItemCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)
}

model Claim {
  id                 String      @id @default(uuid()) @db.Uuid
  claimCode          String      @unique
  foundItemId        String      @db.Uuid
  foundItem          FoundItem   @relation(fields: [foundItemId], references: [id])
  claimantUserId     String      @db.Uuid
  claimantUser       User        @relation(fields: [claimantUserId], references: [id])
  submittedProof     Json
  status             ClaimStatus @default(PENDING_VERIFICATION)
  reviewerNote       String?
  reservationExpiresAt DateTime? @db.Timestamptz(6)
  decisionAtUtc      DateTime?   @db.Timestamptz(6)
  verifiedByAdminId  String?     @db.Uuid
  verifiedByAdmin    User?       @relation("ClaimVerifiedBy", fields: [verifiedByAdminId], references: [id])
  pickupToken        String?
  pickupTokenExpires DateTime?   @db.Timestamptz(6)
  handoverLogs       HandoverLog[]
  messages           ClaimMessage[]
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)

  @@index([foundItemId])
  @@index([claimantUserId])
  @@index([status])
}

model ClaimMessage {
  id        String   @id @default(uuid()) @db.Uuid
  claimId   String   @db.Uuid
  claim     Claim    @relation(fields: [claimId], references: [id])
  sender    UserRole
  message   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([claimId])
}

model LostReport {
  id                String       @id @default(uuid()) @db.Uuid
  reportCode        String       @unique
  reporterUserId    String       @db.Uuid
  reporterUser      User         @relation(fields: [reporterUserId], references: [id])
  title             String
  category          String
  color             String
  location          String
  reportedLostAtUtc DateTime     @db.Timestamptz(6)
  timeWindow        String?
  proofData         Json
  status            ReportStatus @default(SUBMITTED)
  matchedItemId     String?      @db.Uuid
  matchedItem       FoundItem?   @relation("ReportMatchedItem", fields: [matchedItemId], references: [id])
  messages          ReportMessage[]
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  @@index([reporterUserId])
  @@index([status])
}

model AIEvidenceLog {
  id               String    @id @default(uuid()) @db.Uuid
  foundItemId      String?   @db.Uuid
  foundItem        FoundItem? @relation(fields: [foundItemId], references: [id])
  sourceCameraId   String
  snapshotPath     String
  snapshotHash     String?
  isEncrypted      Boolean   @default(true)
  detectionMeta    Json
  detectedAtUtc    DateTime  @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  dismissedAt      DateTime? @db.Timestamptz(6)

  @@index([foundItemId])
}

model HandoverLog {
  id                 String   @id @default(uuid()) @db.Uuid
  foundItemId         String   @db.Uuid
  foundItem           FoundItem @relation(fields: [foundItemId], references: [id])
  claimId             String?  @db.Uuid
  claim               Claim?   @relation(fields: [claimId], references: [id])
  releasedToUserId    String   @db.Uuid
  releasedToUser      User     @relation(fields: [releasedToUserId], references: [id])
  pickupTokenPresented String
  idVerified          Boolean  @default(false)
  releasedAtUtc       DateTime @db.Timestamptz(6)
  note                String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  @@index([foundItemId])
  @@index([releasedToUserId])
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String      @db.Uuid
  actorUser    User        @relation(fields: [actorUserId], references: [id])
  action       AuditAction
  targetType   String
  targetId     String
  description  String?
  payload      Json?
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
}

model ReportMessage {
  id        String     @id @default(uuid()) @db.Uuid
  reportId  String     @db.Uuid
  report    LostReport @relation(fields: [reportId], references: [id])
  sender    UserRole
  message   String
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  @@index([reportId])
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedById String?  @db.Uuid
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  route     String?
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, type, readAt])
  @@index([createdAt])
}

model Camera {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  name            String
  location        String
  sourceUrl       String
  zoneConfig      Json?
  isOnline        Boolean   @default(false)
  streamEnabled   Boolean   @default(true)
  aiEnabled       Boolean   @default(false)
  streamStatus    CameraStreamStatus @default(OFFLINE)
  lastFrameAtUtc  DateTime? @db.Timestamptz(6)
  lastError       String?
  lastPingAtUtc   DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  @@index([isOnline])
  @@index([aiEnabled])
}
